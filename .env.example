# Database (Local Docker or Cloud PostgreSQL e.g. Supabase / Neon)
DATABASE_URL=postgresql://contextmind:contextmind@localhost:5432/contextmind

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Workspace (Single workspace auto-resolved if empty)
WORKSPACE_ID=

# AI Provider Selection: 'auto' | 'ollama' | 'groq'
# In 'auto' mode: uses Groq if GROQ_API_KEY is provided, otherwise falls back to local Ollama
AI_PROVIDER=auto

# Cloud AI Provider (Groq - 100% Free Cloud Inference for Production Deployment)
# Get a free key at https://console.groq.com/keys (No credit card required)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local AI Configuration (Ollama - Free & Local Development)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional Web Search (Tavily)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# Frontend API URL (Configured in Netlify environment variables for client)
# VITE_API_BASE_URL=https://your-backend.koyeb.app/api/v1
