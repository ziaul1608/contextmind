generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  conversations Conversation[]
  memories      Memory[]

  @@map("workspaces")
}

model Conversation {
  id                     String         @id @default(cuid())
  workspaceId            String         @map("workspace_id")
  title                  String
  summary                String?        @db.Text
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages               Message[]
  toolExecutions         ToolExecution[]
  memories               Memory[]

  @@index([workspaceId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String          @id @default(cuid())
  conversationId String          @map("conversation_id")
  role           MessageRole
  content        String          @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  searchVector   Unsupported("tsvector")? @map("search_vector")
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources        MessageSource[]
  memories       Memory[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Memory {
  id                   String        @id @default(cuid())
  workspaceId          String        @map("workspace_id")
  content              String        @db.Text
  category             String        @default("general")
  sourceConversationId String?       @map("source_conversation_id")
  sourceMessageId      String?       @map("source_message_id")
  originalTimestamp    DateTime      @default(now()) @map("original_timestamp") @db.Timestamptz
  importance           Float         @default(0.5)
  sourceType           String        @default("user_provided") @map("source_type")
  status               String        @default("active")
  supersededById       String?       @map("superseded_by_id")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  searchVector         Unsupported("tsvector")? @map("search_vector")

  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceConversation   Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessage        Message?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, category])
  @@index([sourceConversationId])
  @@map("memories")
}

model MessageSource {
  id            String   @id @default(cuid())
  messageId     String   @map("message_id")
  citationIndex Int      @map("citation_index")
  title         String
  url           String
  snippet       String   @db.Text
  score         Float
  retrievedAt   DateTime @map("retrieved_at") @db.Timestamptz
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, citationIndex])
  @@index([messageId])
  @@map("message_sources")
}

model ToolExecution {
  id             String        @id @default(cuid())
  conversationId String        @map("conversation_id")
  toolName       String        @map("tool_name")
  input          Json
  output         Json?
  status         ToolStatus
  errorMessage   String?       @map("error_message") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("tool_executions")
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ToolStatus {
  PENDING
  SUCCESS
  ERROR
  TIMEOUT
}
